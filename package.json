  "homepage": "https://rotalabs.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/rotalabs/rotalabs-redqueen-js.git"
  },
  "bugs": {
    "url": "https://github.com/rotalabs/rotalabs-redqueen-js/issues"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
